# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# Your cell, E.164. Only these numbers can talk to the clanker (comma-separate
# for more). Leave empty to allow anyone — not recommended, it holds a wallet.
ALLOWED_CALLERS=+15557654321

# --- ElevenLabs (elevenlabs.io) — optional; falls back to Twilio Polly voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Server ---
PORT=3334
# ngrok/cloudflared URL (npm run tunnel prints it), no trailing slash
PUBLIC_URL=
# Set to "false" only for local TwiML testing without real Twilio signatures
TWILIO_VALIDATE=true

# --- Agent ---
CLANKER_MODEL=claude-fable-5
MAX_TRADE_USD=100
