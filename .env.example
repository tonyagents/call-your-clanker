# --- Twilio (console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567

# Public demo mode. true (default) = anyone may call; the agent is read-only and
# strangers get market data + recommendations only, never your portfolio.
# Set false to lock the line to ALLOWED_CALLERS.
PUBLIC_MODE=true

# Your number(s), E.164, comma-separated. These callers are treated as the wallet
# owner and additionally get read-only access to your own portfolio (balances,
# PnL, positions, history). Everyone else is public/market-data-only.
ALLOWED_CALLERS=+15557654321

# --- ElevenLabs (elevenlabs.io) — optional; falls back to Twilio Polly voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Server ---
PORT=3334
# ngrok/cloudflared URL (npm run tunnel prints it), no trailing slash
PUBLIC_URL=
# Set to "false" only for local TwiML testing without real Twilio signatures
TWILIO_VALIDATE=true

# --- Agent ---
# Must be a model your `claude` CLI has access to.
CLANKER_MODEL=claude-fable-5
